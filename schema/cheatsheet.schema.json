{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wstein/sheetmill/schema/cheatsheet.schema.json",
  "title": "SheetMill source metadata v0.1",
  "type": "object",
  "required": ["title"],
  "properties": {
    "title": {"type": "string", "pattern": "\\S"},
    "category": {"type": "string"},
    "description": {"type": "string"},
    "tags": {"type": "array", "items": {"type": "string", "pattern": "\\S"}},
    "navigation": {
      "type": "object",
      "properties": {
        "group": {"type": "string", "pattern": "\\S"},
        "order": {"type": "integer", "minimum": 0, "maximum": 1000000}
      },
      "additionalProperties": false
    },
    "cheatsheet": {
      "type": "object",
      "properties": {
        "schema": {"type": "integer", "const": 1},
        "tool": {"type": "string", "pattern": "\\S"},
        "cards": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "params": {
                "type": "object",
                "propertyNames": {
                  "pattern": "^[a-z][a-z0-9_]{0,31}$"
                },
                "additionalProperties": {
                  "type": "object",
                  "required": [
                    "type"
                  ],
                  "properties": {
                    "type": {
                      "enum": [
                        "string",
                        "int",
                        "path"
                      ]
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^\\S(?:[^\\x00-\\x1F\\x7F\\u2028\\u2029]*\\S)?$",
                      "$comment": "Source validation additionally rejects every Unicode control and format character, and surrounding Unicode whitespace."
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
