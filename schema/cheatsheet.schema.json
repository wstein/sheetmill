{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wstein/sheetmill/schema/cheatsheet.schema.json",
  "title": "SheetMill source metadata v0.1",
  "type": "object",
  "required": ["title"],
  "properties": {
    "title": {"type": "string", "pattern": "\\S"},
    "category": {"type": "string"},
    "description": {"type": "string"},
    "tags": {"type": "array", "items": {"type": "string", "pattern": "\\S"}},
    "navigation": {
      "type": "object",
      "properties": {
        "group": {"type": "string", "pattern": "\\S"},
        "order": {"type": "integer", "minimum": 0, "maximum": 1000000}
      },
      "additionalProperties": false
    },
    "cheatsheet": {
      "type": "object",
      "properties": {
        "schema": {"type": "integer", "const": 1},
        "tool": {"type": "string", "pattern": "\\S"},
        "updated": {
          "type": "string",
          "pattern": "^(?:19[7-9][0-9]|[2-9][0-9]{3})-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])$",
          "$comment": "Author-stated date the sheet was last updated, written YYYY-MM-DD with ASCII digits, years 1970 to 9999. Quote it: YAML 1.1 tools turn a bare date into a date object, which this string schema rejects. SheetMill itself accepts the bare form. The pattern is looser than SheetMill for calendar validity (it accepts 2026-02-30); source validation checks real dates and reports VAL004. No time or clock comparison exists, so a future date is valid."
        },
        "tool_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[^\\p{Z}\\p{Cc}\\p{Cf}](?:[^\\p{Cc}\\p{Cf}\\p{Zl}\\p{Zp}]*[^\\p{Z}\\p{Cc}\\p{Cf}])?$",
          "allOf": [{"pattern": "[^\\u115F\\u1160\\u3164\\uFFA0\\u2800]"}],
          "$comment": "Version of the documented tool, shown as authored: one line of 1 to 64 code points without surrounding whitespace, control or format characters, and not only the blank-looking fillers U+115F, U+1160, U+3164, U+FFA0 and U+2800. Source validation also rejects invalid UTF-8 and reports VAL004. Private-use and unassigned code points are accepted on purpose. The pattern uses \\p{Z}, \\p{Cc} and \\p{Cf}, so validators must compile it as an ECMA-262 regular expression in Unicode mode (the u flag)."
        },
        "cards": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "params": {
                "type": "object",
                "propertyNames": {
                  "pattern": "^[a-z][a-z0-9_]{0,31}$"
                },
                "additionalProperties": {
                  "type": "object",
                  "required": [
                    "type"
                  ],
                  "properties": {
                    "type": {
                      "enum": [
                        "string",
                        "int",
                        "path"
                      ]
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^\\S(?:[^\\x00-\\x1F\\x7F\\u2028\\u2029]*\\S)?$",
                      "$comment": "Source validation additionally rejects every Unicode control and format character, and surrounding Unicode whitespace."
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
